# Slanted Poiseuille flow requires a more conservative CFL number.
time.cfl = 0.5

incflo.physics = ChannelBuilder
incflo.velocity = 0.0 0.0 0.0

ICNS.source_terms = DragForcing BodyForce
# The temporal limiter is the canonical default configuration.
DragForcing.use_original_drag_limiter = false
DragForcing.use_temporal_drag_limiter = true
BodyForce.magnitude = 1.1313708498984762 0.0 1.1313708498984760

# Three periodic segments at 45 degrees.
ChannelBuilder.segment_labels = s1 s2 s3

ChannelBuilder.s1.flow_speed = 100.0000
ChannelBuilder.s1.velocity_profile = Uniform
ChannelBuilder.s1.type = Trapezoid
ChannelBuilder.s1.top_width_start = 500.0000
ChannelBuilder.s1.top_width_end = 500.0000
ChannelBuilder.s1.bottom_width_start = 500.0000
ChannelBuilder.s1.bottom_width_end = 500.0000
ChannelBuilder.s1.height_start = 500.0000
ChannelBuilder.s1.height_end = 500.0000
ChannelBuilder.s1.segment_start_point = 0.0 62.5 0.0
ChannelBuilder.s1.segment_end_point = 1000.0 62.5 1000.0

ChannelBuilder.s2.flow_speed = 100.0000
ChannelBuilder.s2.velocity_profile = Uniform
ChannelBuilder.s2.type = Trapezoid
ChannelBuilder.s2.top_width_start = 500.0000
ChannelBuilder.s2.top_width_end = 500.0000
ChannelBuilder.s2.bottom_width_start = 500.0000
ChannelBuilder.s2.bottom_width_end = 500.0000
ChannelBuilder.s2.height_start = 500.0000
ChannelBuilder.s2.height_end = 500.0000
ChannelBuilder.s2.segment_start_point = -500.0 62.5 500.0
ChannelBuilder.s2.segment_end_point = 500.0 62.5 1500.0

ChannelBuilder.s3.flow_speed = 100.0000
ChannelBuilder.s3.velocity_profile = Uniform
ChannelBuilder.s3.type = Trapezoid
ChannelBuilder.s3.top_width_start = 500.0000
ChannelBuilder.s3.top_width_end = 500.0000
ChannelBuilder.s3.bottom_width_start = 500.0000
ChannelBuilder.s3.bottom_width_end = 500.0000
ChannelBuilder.s3.height_start = 500.0000
ChannelBuilder.s3.height_end = 500.0000
ChannelBuilder.s3.segment_start_point = 500.0 62.5 -500.0
ChannelBuilder.s3.segment_end_point = 1500.0 62.5 500.0

# Mesh and geometry
amr.n_cell = 32 4 32
amr.max_level = 0
amr.blocking_factor = 4

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1000.0 125.0 1000.0
geometry.is_periodic = 1 1 1

xlo.density = 1.0
xlo.temperature = 300.0
